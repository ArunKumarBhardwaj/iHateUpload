{
  "name": "ihateupload",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "next dev --port 43127",
    "build": "next build",
    "start": "next start --port 43127",
    "lint": "eslint",
    "test": "bun test src/lib/sw-cache.test.ts src/lib/ocr-words.test.ts src/lib/edit-pdf.test.ts",
    "sync-pdf-worker": "cp node_modules/pdfjs-dist/legacy/build/pdf.worker.min.mjs public/pdf.worker.min.mjs",
    "build-sw": "bun build src/sw.ts --outfile public/sw.js --target browser --format iife",
    "prebuild": "bun run sync-pdf-worker && bun run build-sw"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.9.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "heic2any": "^0.0.4",
    "jszip": "^3.10.1",
    "lucide-react": "^1.37.0",
    "mammoth": "^1.12.2",
    "next": "16.3.3",
    "pdfjs-dist": "6.2.108",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
